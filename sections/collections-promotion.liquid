{%- style -%}
  #section-{{ section.id }} .collections__promotion-child {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }
  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .collections__promotion-child {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{{ 'section-collection-promotion.css' | asset_url | stylesheet_tag }}

<div class="collections__promotion" id="section-{{ section.id }}">
  <div class="collections__promotion-child full-page-width">
    <div class="collections__promotion-cards">
      {% for block in section.blocks %}
        <div
          class="collections__promotion-card"
          style="--background-color-{{ forloop.index }}: {{ block.settings.background_color }};"
          {{ block.shopify_attributes }}
        >
          <div class="collections__promotion-card-image">
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                class: 'collections__promotion-card-image',
                loading: 'lazy',
                width: block.settings.image.width,
                height: block.settings.image.height
            }}
          </div>
          {%- if block.settings.title != blank -%}
            <h2 class="collections__promotion-card-title">{{ block.settings.title }}</h2>
          {%- endif -%}
          <div class="collections__promotion-card-button">
            <a href="{{ block.settings.link }}">{{ 'icon-arrow-chevron.svg' | inline_asset_content }}</a>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="collections__promotion-content">
      <div class="collections__promotion-content-child">
        {%- if section.settings.title != blank -%}
          <h2 class="collections__promotion-content-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.sub_title != blank -%}
          <span class="collections__promotion-content-sub-title">{{ section.settings.sub_title }}</span>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="collections__promotion-content-description">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.link != blank -%}
          <div class="collections__promotion-content-button">
            <a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- schema -%}
{
  "name": "Collections promotion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Seasonal hues, effortlessly stylish"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub title",
      "default": "Stay bold | Stay fun | Game on!"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Step into a world of color with MK Beauty! This season’s collection is all about bold self-expression, vibrant hues, and playful energy. Celebrate your unique style and embrace the joy of fashion with confidence and creativity."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Let's Play"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding top [Desktop]",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding bottom [Desktop]",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding top [Mobile]",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding bottom [Mobile]",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "limit": 2,
      "settings": [
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#ffffff"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Best Sellers"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections promotion",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{%- endschema -%}
