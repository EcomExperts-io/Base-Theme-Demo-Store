{%- style -%}
  #section-{{ section.id }} .exclusive-collection-promo-child {
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .exclusive-collection-promo-child {
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{{ 'section-exclusive-collection-promo.css' | asset_url | stylesheet_tag }}
{{ 'swiper7.4.1.min.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-product-price.css' | asset_url | stylesheet_tag }}

{%- if section.settings.quick_add == 'standard' -%}
  {{ 'component-quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'component-quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="exclusive-collection-promo" id="section-{{ section.id }}" style="--background-color: {{ section.settings.background_color }};">
  <div class="exclusive-collection-promo-child">
    <div class="exclusive-collection-promo-media">
      <div class="exclusive-collection-promo-media-image-container">
        {{
          section.settings.background_image
          | image_url: width: section.settings.background_image.width
          | image_tag: class: 'exclusive-collection-promo-media-image', loading: 'lazy'
        }}
      </div>
      <div class="exclusive-collection-promo-badge">
        <div class="exclusive-collection-promo-badge-content">
          <div class="ec-promo-badge">
            <span>New Arrival</span>
          </div>
          {%- if section.settings.badge_image != blank -%}
            <span class="exclusive-collection-promo-badge-image">
              {{
                section.settings.badge_image
                | image_url: width: section.settings.badge_image.width
                | image_tag: class: 'exclusive-collection-promo-badge-image', loading: 'lazy'
              }}
            </span>
          {%- endif -%}
          <h2>{{ collections[section.settings.collection].title }}</h2>
          <a href="{{ collections[section.settings.collection].url }}" class="exclusive-collection-promo-badge-link">View All Products</a>
        </div>
      </div>
    </div>
    <div class="exclusive-collection-promo-content">
      <div class="exclusive-collection-promo-product-grid">
        <div class="swiper swiper-exclusive-collection">
          <div class="swiper-wrapper">
            {% for product in collections[section.settings.collection].products limit: section.settings.products_limit %}
              <div class="swiper-slide">
                {% render 'component-product-card',
                  card_product: product,
                  show_vendor: section.settings.show_vendor,
                  enable_swatches: section.settings.enable_swatches,
                  swatch_trigger: section.settings.swatch_trigger,
                  swatch_type: section.settings.swatch_type,
                  media_aspect_ratio: section.settings.image_ratio,
                  quick_add: section.settings.quick_add,
                  section_id: section.id
                %}
              </div>
            {% endfor %}
          </div>
          <div class="swiper-pagination"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'swiper7.4.1.min.js' | asset_url }}" defer id="collection-swiper-script"></script>
<script src="{{ 'section-exclusive-collection-promo.js' | asset_url }}" defer></script>

{%- schema -%}
{
  "name": "Exclusive Collecton Promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Limit",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 9
    },
    {
      "type": "header",
      "content": "Product Settings"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_swatches",
      "label": "Enable Swatches",
      "default": false
    },
    {
      "type": "select",
      "id": "swatch_type",
      "label": "Swatch type",
      "options": [
        {
          "value": "color",
          "label": "Color based"
        },
        {
          "value": "image",
          "label": "Image based"
        }
      ],
      "default": "image",
      "info": "Display swatches based on color values or variant images"
    },
    {
      "type": "text",
      "id": "swatch_trigger",
      "label": "Swatch trigger",
      "default": "Color",
      "info": "Enter the product option name to use for variant swatches (e.g. 'Color', 'Size', etc.)"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "info": "t:sections.main-collection-product-grid.settings.quick_add.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fcfdf3"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Margin top [Desktop]",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Margin bottom [Desktop]",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Margin top [Mobile]",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Margin bottom [Mobile]",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Exclusive Collecton Promo"
    }
  ]
}
{%- endschema -%}
