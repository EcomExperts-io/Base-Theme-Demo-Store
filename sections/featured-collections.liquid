{%- style -%}
  #section-{{ section.id }} .featured-collections-child {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }
  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .featured-collections-child {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{{ 'section-featured-collections.css' | asset_url | stylesheet_tag }}

<div class="featured-collections" id="section-{{ section.id }}">
  <div class="featured-collections-child full-page-width">
    <h2 class="featured-collections-title">{{ section.settings.title }}</h2>
    <div class="featured-collections-collections">
      {% for block in section.blocks %}
        <div class="featured-collections-collection" {{ block.shopify_attributes }}>
          <h2 class="featured-collections-collection-title">{{ block.settings.collection.title }}</h2>
          <span class="featured-collections-collection-count">
            {{- block.settings.collection.all_products_count }}
            {{ block.settings.collection.all_products_count | pluralize: 'item', 'items' -}}
          </span>
          <a href="{{ block.settings.collection.url }}" class="featured-collections-collection-link">
            {{
              block.settings.collection.image
              | image_url: width: block.settings.collection.image.width
              | image_tag:
                class: 'featured-collections-collection-image',
                loading: 'lazy',
                width: block.settings.collection.image.width,
                height: block.settings.collection.image.height
            }}
          </a>
          <div class="featured-collections-button">
            <a href="{{ block.settings.collection.url }}" class="featured-collections-button-link">
              {{ 'icon-arrow-chevron.svg' | inline_asset_content }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{%- schema -%}
{
  "name": "Featured collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Collections"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding top [Desktop]",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding bottom [Desktop]",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding top [Mobile]",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding bottom [Mobile]",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{%- endschema -%}
