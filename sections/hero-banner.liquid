{{ 'section-hero-banner.css' | asset_url | stylesheet_tag: preload: true }}

<hero-banner-slider>
  <div class="swiper-hero-banner">
    <div class="swiper-wrapper">
      {% content_for 'blocks' %}
    </div>
    <div class="swiper-pagination"></div>
  </div>
</hero-banner-slider>

<script src="{{ 'swiper7.4.1.min.js' | asset_url }}" defer="defer" id="swiper-script"></script>
<script src="{{ 'section-hero-banner.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero banner",
  "blocks": [{ "type": "_component-hero-banner-slider" }, { "type": "@app" }],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slider",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slider duration",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
