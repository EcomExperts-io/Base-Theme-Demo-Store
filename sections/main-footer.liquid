{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-main-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Custom styles to match the design */
  .footer {
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .dark-mode-active .footer {
    background-color: rgb(var(--dark-color-background));
    color: rgb(var(--dark-color-foreground));
  }

  .footer-block__heading {
    font-weight: 600;
    margin-bottom: 1rem;
    font-size: 1.6rem;
    text-transform: uppercase;
  }

  .footer__list-social {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin: 2rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e5e5;
  }

  .list-payment {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .list-payment__item .icon--full-color {
    height: 24px;
    width: auto;
  }

  .footer__copyright {
    text-align: right;
    margin-top: 2rem;
    font-size: 1rem;
    color: rgb(var(--color-foreground));
    border-top: 1px solid #e5e5e5;
    padding-top: 1.5rem;
  }

  .dark-mode-active .footer__copyright {
    color: rgb(var(--dark-color-foreground));
  }

  .footer__copyright a {
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  .dark-mode-active .footer__copyright a {
    color: rgb(var(--dark-color-foreground));
  }

  .footer__copyright a:hover {
    text-decoration: underline;
  }

  .footer-block__details-content.list-unstyled li {
    margin-bottom: 0.5rem;
  }

  .footer-block__details-content.list-unstyled a {
    color: rgb(var(--color-foreground));
    text-decoration: none;
    font-size: 1.6rem;
  }

  .dark-mode-active .footer-block__details-content.list-unstyled a {
    color: rgb(var(--dark-color-foreground));
  }

  .footer-block__details-content.list-unstyled a:hover {
    text-decoration: underline;
  }

  .footer__list-social-item img {
    filter: grayscale(100%);
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }
  .footer__list-social-item:hover img {
    opacity: 1;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .footer .page-width {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .footer-block__details-content.list-unstyled a {
      font-size: 1.2rem;
      padding: 0;
    }

    .footer-mobile-accordion {
      border-bottom: 1px solid rgb(var(--color-foreground));
      padding: 0;
    }

    .dark-mode-active .footer-mobile-accordion {
      border-bottom: 1px solid rgb(var(--dark-color-foreground));
    }

    .accordion-trigger {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding: 1rem 0;
      background: none;
      border: none;
      text-align: left;
      cursor: pointer;
    }

    .accordion-trigger h2.footer-block__heading {
      margin: 0;
      font-weight: 600;
      font-size: 1.2rem;
    }

    .accordion-content {
      display: none;
      padding-bottom: 1rem;
      padding-left: 0;
    }
    .accordion-content ul {
        padding-left: 0;
        list-style: none;
    }
     .accordion-content li {
       margin-bottom: 0.75rem;
       font-size: 1.05rem;
     }

    .accordion-trigger[aria-expanded="true"] + .accordion-content {
      display: block;
    }

    .accordion-icon {
      transition: transform 0.3s ease;
      width: 20px;
      height: 20px;
    }

    .accordion-trigger[aria-expanded="true"] .accordion-icon {
      transform: rotate(180deg);
    }

    .footer__payment-header {
      margin-bottom: 1rem;
    }

    .list-payment {
      justify-content: center;
      padding-bottom: 1rem;
    }

    .footer__list-social {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgb(var(--color-foreground));
    }

    .dark-mode-active .footer__list-social {
      border-top: 1px solid rgb(var(--dark-color-foreground));
    }

    .footer__copyright {
      text-align: center;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgb(var(--color-foreground));
    }

     .footer__copyright .copyright__content {
       display: block;
       margin-bottom: 0.25rem;
     }
     .footer__copyright .copyright__content:nth-child(even) {
       display: none;
     }
  }

  /* Hide/Show Desktop/Mobile */
  @media screen and (max-width: 749px) {
    .hidden-mobile {
      display: none !important;
    }
    .hidden-desktop {
      display: block !important;
    }
  }
  @media screen and (min-width: 750px) {
    .hidden-mobile {
      display: block !important;
    }
    .hidden-desktop {
      display: none !important;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- liquid
    assign has_social_icons = false
    if section.settings.social_instagram_link != blank or section.settings.social_facebook_link != blank or section.settings.social_youtube_link != blank or section.settings.social_tiktok_link != blank or section.settings.social_twitter_link != blank or section.settings.social_pinterest_link != blank or section.settings.social_linkedin_link != blank
      assign has_social_icons = true
    endif

    assign payment_heading = 'PAYMENT GATEWAYS'
  -%}

  <div class="page-width footer__content-top">
    <!-- Desktop Footer -->
    <div class="footer-desktop-only hidden-mobile">
      {%- if section.blocks.size > 0 -%}
        {%- liquid
          assign footer_grid_items = section.blocks.size
          if section.settings.show_payment_icons
            assign footer_grid_items = section.blocks.size | plus: 1
          endif
          assign grid_col_desktop = 'grid--' | append: footer_grid_items | append: '-col-desktop'
        -%}
        <div class="grid {{ grid_col_desktop }}">
          {%- for block in section.blocks -%}
            <div class="grid__item" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer-block__heading">{{- block.settings.heading | escape -}}</h2>
              {%- endif -%}

              {%- if block.type == 'link_list' and block.settings.menu != blank -%}
                <ul class="footer-block__details-content list-unstyled">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                      >
                        {{ link.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}

          {%- if section.settings.show_payment_icons -%}
            <div class="grid__item footer__payment">
              {%- if payment_heading != blank -%}
                <h2 class="footer-block__heading">{{ payment_heading }}</h2>
              {%- endif -%}
              <ul class="list list-payment" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Mobile Footer -->
    <div class="footer-mobile-only hidden-desktop">
      {%- for block in section.blocks -%}
        <div class="footer-mobile-accordion" {{ block.shopify_attributes }}>
          <button class="accordion-trigger" aria-expanded="false" aria-controls="footer-content-{{ block.id }}">
            {%- if block.settings.heading != blank -%}
              <h2 class="footer-block__heading">{{- block.settings.heading | escape -}}</h2>
            {%- endif -%}
            <span class="accordion-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          <div class="accordion-content" id="footer-content-{{ block.id }}">
            {%- if block.type == 'link_list' and block.settings.menu != blank -%}
              <ul class="footer-block__details-content list-unstyled">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a
                      href="{{ link.url }}"
                      class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                    >
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}

      {%- if section.settings.show_payment_icons -%}
        <div class="footer-mobile-accordion footer__payment">
          <button class="accordion-trigger" aria-expanded="false" aria-controls="footer-content-payment">
            {%- if payment_heading != blank -%}
              <h2 class="footer-block__heading footer__payment-header">{{ payment_heading }}</h2>
            {%- endif -%}
            <span class="accordion-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          <div class="accordion-content" id="footer-content-payment">
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Social Icons Row -->
  {%- if section.settings.show_social_icons and has_social_icons -%}
    <div class="page-width footer__list-social">
      {%- if section.settings.social_instagram_link != blank -%}
        <a href="{{ section.settings.social_instagram_link }}" class="footer__list-social-item" aria-describedby="a11y-external-message">
          <img src="{{ 'icon-instagram.svg' | asset_url }}" alt="Instagram" width="24" height="24">
        </a>
      {%- endif -%}
      {%- if section.settings.social_facebook_link != blank -%}
        <a href="{{ section.settings.social_facebook_link }}" class="footer__list-social-item" aria-describedby="a11y-external-message">
          <img src="{{ 'icon-facebook.svg' | asset_url }}" alt="Facebook" width="24" height="24">
        </a>
      {%- endif -%}
      {%- if section.settings.social_pinterest_link != blank -%}
        <a href="{{ section.settings.social_pinterest_link }}" class="footer__list-social-item" aria-describedby="a11y-external-message">
          <img src="{{ 'icon-pinterest.svg' | asset_url }}" alt="Pinterest" width="24" height="24">
        </a>
      {%- endif -%}
      {%- if section.settings.social_youtube_link != blank -%}
        <a href="{{ section.settings.social_youtube_link }}" class="footer__list-social-item" aria-describedby="a11y-external-message">
          <img src="{{ 'icon-youtube.svg' | asset_url }}" alt="YouTube" width="24" height="24">
        </a>
      {%- endif -%}
      {%- if section.settings.social_twitter_link != blank -%}
        <a href="{{ section.settings.social_twitter_link }}" class="footer__list-social-item" aria-describedby="a11y-external-message">
          <img src="{{ 'icon-twitter.svg' | asset_url }}" alt="Twitter" width="24" height="24">
        </a>
      {%- endif -%}
      {%- if section.settings.social_tiktok_link != blank -%}
        <a href="{{ section.settings.social_tiktok_link }}" class="footer__list-social-item" aria-describedby="a11y-external-message">
          <img src="{{ 'icon-tiktok.svg' | asset_url }}" alt="TikTok" width="24" height="24">
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Copyright Section -->
  <div class="footer__content-bottom page-width">
    <div class="footer__copyright caption">
      <small class="copyright__content">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small>
      <small class="copyright__content copyright__divider" aria-hidden="true">|</small>
      <small class="copyright__content"><a href="{{ routes.privacy_policy_url | default: "#" }}">Privacy Policy</a></small>
      <small class="copyright__content copyright__divider" aria-hidden="true">|</small>
      <small class="copyright__content"><a href="{{ routes.terms_of_service_url | default: "#" }}">Terms of Use</a></small>
      <small class="copyright__content copyright__divider" aria-hidden="true">|</small>
      <small class="copyright__content"
        ><a href="{{ routes.accessibility_statement_url | default: "/pages/accessibility" }}">Accessibility Statement</a></small
      >
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Accordion functionality for mobile
    const footer = document.querySelector('.footer-mobile-only');
    if (footer) {
      const accordionTriggers = footer.querySelectorAll('.accordion-trigger');

      accordionTriggers.forEach((trigger) => {
        trigger.addEventListener('click', function () {
          const content = this.nextElementSibling;
          const expanded = this.getAttribute('aria-expanded') === 'true';

          // Close other accordions
          accordionTriggers.forEach((otherTrigger) => {
            if (otherTrigger !== this && otherTrigger.getAttribute('aria-expanded') === 'true') {
              otherTrigger.setAttribute('aria-expanded', 'false');
              otherTrigger.nextElementSibling.style.display = 'none';
            }
          });

          // Toggle clicked accordion
          this.setAttribute('aria-expanded', !expanded);
          content.style.display = expanded ? 'none' : 'block';
        });
      });
    }

    // Media query handling is now done via CSS classes (.hidden-mobile, .hidden-desktop)
    // JavaScript for toggling display is removed to rely purely on CSS media queries
  });
</script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "text",
      "id": "social_instagram_link",
      "label": "Instagram Link",
      "info": "Enter the full URL of your Instagram profile"
    },
    {
      "type": "text",
      "id": "social_facebook_link",
      "label": "Facebook Link",
      "info": "Enter the full URL of your Facebook profile"
    },
    {
      "type": "text",
      "id": "social_pinterest_link",
      "label": "Pinterest Link",
      "info": "Enter the full URL of your Pinterest profile"
    },
    {
      "type": "text",
      "id": "social_youtube_link",
      "label": "YouTube Link",
      "info": "Enter the full URL of your YouTube channel"
    },
    {
      "type": "text",
      "id": "social_twitter_link",
      "label": "Twitter Link",
      "info": "Enter the full URL of your Twitter profile"
    },
    {
      "type": "text",
      "id": "social_tiktok_link",
      "label": "TikTok Link",
      "info": "Enter the full URL of your TikTok profile"
    },
    {
      "type": "text",
      "id": "social_linkedin_link",
      "label": "LinkedIn Link",
      "info": "Enter the full URL of your LinkedIn profile"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "default": {
    "blocks": [{ "type": "link_list" }, { "type": "link_list" }, { "type": "link_list" }]
  }
}
{% endschema %}
