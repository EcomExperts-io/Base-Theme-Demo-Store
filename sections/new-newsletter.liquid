<div class="newsletter-section">
  <div class="newsletter-container">
    <div class="newsletter-content">
      <h2 class="newsletter-heading">JOIN MK BEAUTY CLUB</h2>
      <p class="newsletter-description">
        Do you want to receive Barton's latest on product releases and exclusive offers? Enter your email & stay in the know!
      </p>
    </div>
    <form class="newsletter-form" action="/contact#newsletter-form" method="post">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form-fields">
        <div class="newsletter-input-wrapper">
          <input
            type="email"
            name="contact[email]"
            id="newsletter-email"
            class="newsletter-input"
            placeholder="Enter your email"
            required
          >
        </div>
        <button type="submit" class="newsletter-submit">SIGN UP</button>
      </div>
    </form>
  </div>
</div>

<style>
  .newsletter-section {
    position: relative;
    width: 100%;
    height: 399px;
    background-image: url('https://blackmamba-5.myshopify.com/cdn/shop/files/Apple_Watch_Band_1.png?v=1744804919&width=4320');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 20px;
  }

  .newsletter-container {
    max-width: 541px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .newsletter-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 488px;
  }

  .newsletter-heading {
    font-family: 'Assistant', sans-serif;
    font-weight: 700;
    font-size: 40px;
    line-height: 56px;
    margin: 0;
    color: #000000;
  }

  .newsletter-description {
    font-family: 'Assistant', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 24px;
    margin: 0;
    color: #000000;
  }

  .newsletter-form-fields {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .newsletter-input-wrapper {
    flex: 1;
    max-width: 400px;
  }

  .newsletter-input {
    width: 100%;
    height: 50px;
    border: 1px solid #000000;
    padding: 0 15px;
    font-family: 'Assistant', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 25px;
    background-color: transparent;
  }

  .newsletter-submit {
    height: 50px;
    padding: 15px 30px;
    background-color: #000000;
    border: 1px solid #000000;
    color: #ffffff;
    font-family: 'Assistant', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 20px;
    cursor: pointer;
    white-space: nowrap;
  }

  .newsletter-submit:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 767px) {
    .newsletter-section {
      height: auto;
      padding: 40px 20px;
    }

    .newsletter-form-fields {
      flex-direction: column;
      align-items: stretch;
    }

    .newsletter-input-wrapper {
      max-width: 100%;
    }

    .newsletter-submit {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN MK BEAUTY CLUB"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Do you want to receive Barton's latest on product releases and exclusive offers? Enter your email & stay in the know!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SIGN UP"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
