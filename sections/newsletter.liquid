{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

<div class="newsletter-section">
  <div class="newsletter-container page-width">
    <div class="newsletter-content">
      {%- if section.settings.heading -%}
        <h2 class="newsletter-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description -%}
        <p class="newsletter-description">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>
    <form class="newsletter-form" action="/contact#newsletter-form" method="post">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form-fields">
        <div class="newsletter-input-wrapper">
          <input
            type="email"
            name="contact[email]"
            id="newsletter-email"
            class="newsletter-input"
            placeholder="Enter your email"
            required
          >
        </div>
        {%- if section.settings.button_text -%}
          <button type="submit" class="newsletter-submit">
            {{ section.settings.button_text }}
          </button>
        {%- else -%}
          <button type="submit" class="newsletter-submit">SIGN UP</button>
        {%- endif -%}
      </div>
    </form>
  </div>
</div>


{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN MK BEAUTY CLUB"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Do you want to receive Barton's latest on product releases and exclusive offers? Enter your email & stay in the know!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SIGN UP"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
